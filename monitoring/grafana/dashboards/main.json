              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 130 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": -1 },
                    { "color": "yellow", "value": -0.1 },
                    { "color": "light-green", "value": 0.1 },
                    { "color": "green", "value": 1 }
