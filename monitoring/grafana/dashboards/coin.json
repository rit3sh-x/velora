          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "rgba(115, 191, 105, 0.10)", "value": null },
