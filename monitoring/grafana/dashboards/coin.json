    {
      "id": 10,
      "type": "candlestick",
      "title": "${coin} — OHLCV + EMA12 / EMA26 / SMA20 / SMA50",
      "description": "1-minute candles with four overlay moving averages. EMA12 (orange) and EMA26 (cyan) are short-term momentum. SMA20 (yellow) is intermediate trend. SMA50 (gray) is the slow baseline.",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 14 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "velora" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "velora" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/coin/${coin}/candles?hours=24",
          "url_options": { "method": "GET", "data": "" },
          "root_selector": "",
          "columns": [
            { "selector": "ts", "text": "time", "type": "timestamp" },
            { "selector": "open", "text": "open", "type": "number" },
            { "selector": "high", "text": "high", "type": "number" },
            { "selector": "low", "text": "low", "type": "number" },
            { "selector": "close", "text": "close", "type": "number" },
            { "selector": "volume", "text": "volume", "type": "number" },
            { "selector": "ema12", "text": "EMA12", "type": "number" },
            { "selector": "ema26", "text": "EMA26", "type": "number" },
            { "selector": "sma20", "text": "SMA20", "type": "number" },
            { "selector": "sma50", "text": "SMA50", "type": "number" }
          ],
          "filters": []
        }
      ],
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": { "up": "#73BF69", "down": "#F2495C", "flat": "gray" },
        "includeAllFields": true,
        "fields": {
          "open": "open",
          "high": "high",
          "low": "low",
          "close": "close",
          "volume": "volume"
        },
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 4 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "EMA12" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.lineInterpolation", "value": "smooth" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "EMA26" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.lineInterpolation", "value": "smooth" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "SMA20" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FADE2A" } },
              { "id": "custom.lineWidth", "value": 1.5 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "SMA50" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#B0BEC5" } },
              { "id": "custom.lineWidth", "value": 1.5 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 6] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "volume" },
            "properties": [
              { "id": "unit", "value": "short" }
            ]
          }
        ]
      }
