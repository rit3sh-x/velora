# ── Cross-machine networking ─────────────────────────────────
# Producer machine LAN IP (used by kafka advertised listener).
# Set to actual LAN IP (e.g. 192.168.1.50) on producer host for cross-machine.
# Leave as localhost for single-machine dev.
HOST_LAN_IP=localhost

# Consumer connects to this kafka broker. Use producer LAN IP:9092 cross-machine.
KAFKA_BROKER=localhost:9092

# ── TimescaleDB (silver + gold) ──────────────────────────────
POSTGRES_DB=velora
POSTGRES_USER=velora
POSTGRES_PASSWORD=velora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MongoDB (bronze: raw tweets) ─────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=velora
MONGODB_TWEETS_COLLECTION=raw_tweets

# ── Twitter (Nitter scrape) ──────────────────────────────────
NITTER_URL=https://nitter.tiekoetter.com
TWEET_POLL_INTERVAL_SECONDS=120
TWEETS_PER_SCRAPE=100
TWEET_MAX_PAGES=12
PLAYWRIGHT_TIMEOUT_MS=45000

# ── Tweet historical backfill (seed) ─────────────────────────
TWEET_BACKFILL_ENABLED=true
TWEET_BACKFILL_DAYS=2
TWEET_BACKFILL_MIN_FAVES=0
TWEET_BACKFILL_PAGES_PER_DAY=30
TWEET_BACKFILL_MAX_PER_DAY=600

# ── Bluesky ──────────────────────────────────────────────────
# LIVE = unauth Jetstream WS firehose (producer filters by coin keyword).
# SEED = unauth public XRPC searchPosts (no app-password needed).
BLUESKY_JETSTREAM_URL=wss://jetstream1.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post
BLUESKY_PUBLIC_API_URL=https://public.api.bsky.app
BLUESKY_RECONNECT_BACKOFF_INITIAL=2
BLUESKY_RECONNECT_BACKOFF_MAX=60
BLUESKY_SEED_POSTS_PER_QUERY=100

# ── Spark (sentiment compute) ────────────────────────────────
SPARK_MASTER=spark://spark-master:7077
SPARK_KAFKA_BOOTSTRAP=kafka:9092
SPARK_CHECKPOINT_DIR=/opt/spark/checkpoints
SPARK_VADER_TRIGGER_SECONDS=30
SPARK_BERT_TRIGGER_SECONDS=300
HF_HOME=/opt/spark/hf-cache

# ── Sentiment backend selector ───────────────────────────────
# `spark` (default): Spark Structured Streaming computes sentiment.
# `python` (legacy): in-process VADER/BERT workers in consumer.
# Mutually exclusive. Per V27.
SENTIMENT_BACKEND=spark

# ── Consumer worker cadence ──────────────────────────────────
VADER_INTERVAL_SECONDS=30
BERT_INTERVAL_SECONDS=300
AGGREGATOR_INTERVAL_SECONDS=60
LIVE_SENTIMENT_INTERVAL_SECONDS=60
MAINTENANCE_INTERVAL_SECONDS=21600
CAGG_REFRESH_INTERVAL_SECONDS=60

# ── BERT settings ────────────────────────────────────────────
BERT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
BERT_BATCH_SIZE=64
BERT_ENABLED=true

# ── Predictive + Prescriptive ────────────────────────────────
PREDICT_HORIZONS=15,60,240
PREDICT_INTERVAL_SECONDS=300
RECOMMEND_INTERVAL_SECONDS=300

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
